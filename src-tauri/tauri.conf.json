{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "대한민국 역명 통합 검색",
  "version": "0.1.0",
  "identifier": "kr.korsub.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "대한민국 역명 통합 검색",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/generated/korsub.sqlite3": "data/korsub.sqlite3"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
